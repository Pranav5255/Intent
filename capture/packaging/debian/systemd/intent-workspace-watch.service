[Unit]
Description=Intent workspace fallback watcher
After=intent-server.service
Wants=intent-server.service
PartOf=intent-backend.target

[Service]
Type=simple
WorkingDirectory=/opt/intent
ExecStart=/usr/bin/intent-workspace-watch
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=intent-backend.target
