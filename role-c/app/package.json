{
  "name": "intent-os-role-c",
  "private": true,
  "version": "0.1.0",
  "description": "Intent OS desktop overlay for Role A and Role B",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "./node_modules/.bin/concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "./node_modules/.bin/vite --host 127.0.0.1 --port 9479 --strictPort",
    "dev:electron": "./node_modules/.bin/wait-on tcp:127.0.0.1:9479 && ./node_modules/.bin/cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:9479 ./node_modules/.bin/electron .",
    "build": "./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build",
    "test": "node --test electron/*.test.cjs && ./node_modules/.bin/vitest run",
    "start": "electron .",
    "package:linux": "npm run build && ./node_modules/.bin/electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.19"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "wait-on": "^8.0.1",
    "vitest": "^2.1.9",
    "jsdom": "^25.0.1"
  },
  "build": {
    "appId": "local.intent-os.role-c",
    "productName": "Intent OS",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
