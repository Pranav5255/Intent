[Unit]
Description=Intent workspace fallback watcher
After=intent-os-server.service
Wants=intent-os-server.service
PartOf=intent-os-backend.target

[Service]
Type=simple
WorkingDirectory=/opt/intent-os
ExecStart=/usr/bin/intent-os-workspace-watch
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=intent-os-backend.target
