[Unit]
Description=Intent OS deterministic intelligence service
After=intent-os-server.service
Wants=intent-os-server.service
PartOf=intent-os-backend.target

[Service]
Type=simple
WorkingDirectory=/opt/intent-os/role-b
ExecStart=/opt/intent-os/role-b/.venv/bin/python -m uvicorn intent_engine.api:app --host 127.0.0.1 --port 9478
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
Environment=ROLE_B_DB_PATH=%h/.local/share/intent-os/intents.db
EnvironmentFile=-%h/.config/intent-os/llm.env

[Install]
WantedBy=intent-os-backend.target
