#!/bin/sh
set -eu

ROOT=/opt/intent-os
POLICY_DIR=/etc/firefox/policies
POLICY_FILE="$POLICY_DIR/policies.json"
POLICY_XPI="$POLICY_DIR/intent-os-firefox.xpi"
TEMPLATE="$ROOT/packaging/debian/firefox-policies.json"
SOURCE_XPI="$ROOT/integrations/firefox-extension/dist/intent-os-firefox.xpi"
LEGACY_POLICY_SHA256=02bfdf3bc6cb06c7ce0e43e25c1beedc94976f18e344f38365cb05066b052002

install_intent_os_policy() {
  # Firefox installed as an Ubuntu Snap may only read host files below its
  # policy directory. Keep the signed XPI next to policies.json instead of
  # under /opt/intent-os.
  install -m 0644 "$SOURCE_XPI" "$POLICY_XPI"
  install -m 0644 "$TEMPLATE" "$POLICY_FILE"
}

# A dev package uses an unsigned local XPI and must not attempt to alter Firefox.
if [ "$(cat "$ROOT/BUILD_MODE" 2>/dev/null || true)" = "release" ]; then
  mkdir -p "$POLICY_DIR"
  if [ -e "$POLICY_FILE" ]; then
    # Migrate only the exact policy written by Intent OS 0.1.0. Any other
    # existing policy is administrator-managed and must be left unchanged.
    if [ "$(sha256sum "$POLICY_FILE" | awk '{print $1}')" = "$LEGACY_POLICY_SHA256" ]; then
      install_intent_os_policy
    else
      echo "Intent OS: existing Firefox policy retained; configure the bundled companion manually." >&2
    fi
  else
    install_intent_os_policy
  fi
fi

exit 0
