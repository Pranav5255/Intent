#!/bin/sh
set -eu

ROOT=/opt/intent-os
POLICY_FILE=/etc/firefox/policies/policies.json
POLICY_XPI=/etc/firefox/policies/intent-os-firefox.xpi
TEMPLATE="$ROOT/packaging/debian/firefox-policies.json"

if [ "${1:-}" = "remove" ] || [ "${1:-}" = "purge" ]; then
  if [ -f "$POLICY_FILE" ] && [ -f "$TEMPLATE" ] && cmp -s "$POLICY_FILE" "$TEMPLATE"; then
    rm -f "$POLICY_FILE"
    rm -f "$POLICY_XPI"
  fi
fi

exit 0
