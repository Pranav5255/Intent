#!/bin/sh
# Launch the self-contained desktop overlay and its local backend.
set -eu

# Launching the UI is an explicit local opt-in to start the metadata-only
# services. Detailed capture remains disabled until the user enables it.
# Never inherit development-only Electron switches into the installed app.
unset ELECTRON_RUN_AS_NODE
unset VITE_DEV_SERVER_URL

/usr/bin/intent-osctl enable
/usr/bin/intent-osctl wait-ready

exec /opt/intent-os/role-c/electron/electron /opt/intent-os/role-c/app "$@"
