[Unit]
Description=Intent OS deterministic intelligence service
After=intent-os-server.service
Wants=intent-os-server.service
PartOf=intent-os.target

[Service]
Type=simple
WorkingDirectory=@INTENT_OS_ROLE_B_ROOT@
ExecStart=@INTENT_OS_ROLE_B_PYTHON@ -m uvicorn intent_engine.api:app --host 127.0.0.1 --port 9478
Restart=on-failure
RestartSec=3
Environment=ROLE_B_DB_PATH=%h/.local/share/intent-os/intents.db
Environment=ROLE_B_LLM_ENABLED=false
Environment=ENABLE_COPILOT=false

[Install]
WantedBy=default.target
