[Unit]
Description=Intent OS X11 foreground window tracker
After=graphical-session.target intent-os-server.service
PartOf=intent-os.target
Requires=intent-os-server.service

[Service]
Type=simple
Environment=INTENT_OS_INSTALL_ROOT=@INTENT_OS_INSTALL_ROOT@
WorkingDirectory=@INTENT_OS_INSTALL_ROOT@
ExecStart=@INTENT_OS_PYTHON@ collectors/x11/tracker.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
