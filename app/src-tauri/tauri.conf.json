{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Intent",
  "version": "2.0.0",
  "identifier": "io.github.pranav5255.Intent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Intent",
        "url": "index.html#/main/today",
        "width": 1180,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Intent",
        "url": "index.html#/overlay",
        "width": 920,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Remembers what you were working on",
    "longDescription": "Intent groups your files, tabs and commands into threads and lets you pick any of them back up from a keyboard palette. Everything stays on this computer unless you choose a cloud model.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
