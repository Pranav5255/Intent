# LLM provider: "gemini" (recommended), "groq", "openai", or "bedrock"
LLM_PROVIDER=gemini

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Groq (only when LLM_PROVIDER=groq). The OpenAI-compatible endpoint is the default.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini auth — prefer a local service account JSON (Vertex AI).
# Point this at a file that is gitignored (see engine/.gitignore). Never commit the JSON.
GOOGLE_APPLICATION_CREDENTIALS=./kube-orch-afd05706a10f.json
# Optional aliases / overrides:
# GEMINI_CREDENTIALS_PATH=./kube-orch-afd05706a10f.json
GOOGLE_CLOUD_PROJECT=kube-orch
GOOGLE_CLOUD_LOCATION=us-central1

# Optional fallback: Gemini Developer API key (AI Studio). Leave blank when using the JSON above.
GEMINI_API_KEY=

# Amazon Bedrock (only when LLM_PROVIDER=bedrock). Choose one authentication method.
# For a Bedrock API key generated in the AWS console, uncomment and set this:
# AWS_BEARER_TOKEN_BEDROCK=
# Or use a named local AWS profile:
# BEDROCK_AWS_PROFILE=bedrock
# Standard AWS IAM credential variables or an attached IAM role also work through boto3.
BEDROCK_REGION=
BEDROCK_TIMEOUT_SECONDS=30
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0
# "auto" skips unsupported schema mode for Amazon Nova Pro; use true/false to override.
BEDROCK_STRUCTURED_OUTPUT=auto
# Set true only when the selected model supports strict tool schemas.
BEDROCK_STRICT_TOOL_USE=false

# Deterministic behavior is the default. Enable both flags to use Copilot.
ENGINE_LLM_ENABLED=false
ENABLE_COPILOT=false


# Semantic clustering is opt-in. Full capture requires the separate, explicit
# consent flag below and sends every Role A event field to the selected LLM.
ENGINE_SEMANTIC_CLUSTER=false
ENGINE_SEMANTIC_TIMEOUT_MS=60000
ENGINE_SEMANTIC_CONTENT_CONSENT=false
ENGINE_SEMANTIC_FULL_CAPTURE_CONSENT=false

# Model name; leave blank to use the selected provider default
# (gpt-4o-mini / gemini-2.5-flash / openai/gpt-oss-20b / amazon.nova-pro-v1:0).
INTENT_LLM_MODEL=

# Local Role B persistence and optional features.
ROLE_B_DB_PATH=intents.db
ENABLE_PREDICTION=false
# Scheduled ingestion is disabled unless the packaged scheduler enables it.
ENABLE_PIPELINE_TRIGGER=false
# When true, today's events are fetched incrementally instead of full day re-export.
ENABLE_INCREMENTAL_INGEST=false
# The systemd timer uses this three-hour cadence.
PIPELINE_TRIGGER_INTERVAL_HOURS=3
